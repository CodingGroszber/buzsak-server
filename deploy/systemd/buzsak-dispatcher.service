[Unit]
Description=Buzsak Pi 3 Server - dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neulas
Group=neulas
WorkingDirectory=/home/neulas/buzsak-pi3-server
Environment=PYTHONPATH=src
Environment=BUZSAK_CONFIG=config/production.yaml
ExecStart=/home/neulas/buzsak-pi3-server/.venv/bin/python -m buzsak_pi3_server.dispatcher
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/neulas/buzsak-pi3-server/data
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
